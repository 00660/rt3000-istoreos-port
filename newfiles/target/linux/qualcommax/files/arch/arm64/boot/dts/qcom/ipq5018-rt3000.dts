/dts-v1/;

#include "ipq5018.dtsi"
#include "ipq5018-ess.dtsi"
#include "ipq5018-qcn6122.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "H3C RT3000";
	compatible = "h3c,rt3000", "qcom,ipq5018";

	aliases {
		ethernet0 = &dp1;
		ethernet1 = &dp2;
		label-mac-device = &dp1;
		led-boot = &led_status;
		led-failsafe = &led_status;
		led-running = &led_status;
		led-upgrade = &led_status;
		serial0 = &blsp1_uart1;
	};

	chosen {
		bootargs-append = "ubi.mtd=rootfs root=/dev/ubiblock0_1 rootfstype=squashfs rootwait swiotlb=1 coherent_pool=2M";
		stdout-path = "serial0:115200n8";
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		button-reset {
			label = "reset";
			gpios = <&tlmm 34 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		button-wps {
			label = "wps";
			gpios = <&tlmm 38 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
		};
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&led_pins>;
		pinctrl-names = "default";

		led_status: status {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
			gpios = <&tlmm 19 GPIO_ACTIVE_HIGH>;
		};
	};
};

&switch {
	status = "okay";
	switch_mac_mode = <MAC_MODE_SGMII_CHANNEL0>;

	qcom,port_phyinfo {
		port@0 {
			port_id = <1>;
			mdiobus = <&mdio0>;
			phy_address = <7>;
		};

		port@1 {
			port_id = <2>;
			forced-speed = <1000>;
			forced-duplex = <1>;
		};
	};
};

&dp1 {
	status = "okay";
};

&dp2 {
	status = "okay";

	fixed-link {
		speed = <1000>;
		full-duplex;
	};
};

&mdio0 {
	status = "okay";
};

&mdio1 {
	status = "okay";
	pinctrl-0 = <&mdio1_pins>;
	pinctrl-names = "default";
	/* 内核 6.12 起 mdio-ipq4019 会用寄存器里的分频值反推 MDC 速率，
	 * 厂商 SSDK 已经把 MDIO1 的分频改成非 2 的幂，反推出来对不上就直接
	 * 返回 -EINVAL（日志: probe failed with error -22）。这里把速率写死，
	 * 100MHz/64 = 1562500Hz，正好落在驱动支持的 8..256 分频表里。 */
	clock-frequency = <1562500>;

	switch0: ethernet-switch@11 {
		compatible = "qca,qca8337";
		/* MDIO 管理地址 = 0x11，取自真机原厂 DTB（NAND 0x36a69d8，
		 * model = "H3C RT3000"，节点名就是 ethernet-switch@11）。
		 * 之前按 qcom-ipq8064-rb3011 改成 0x10 是错的——那是另一块板子。 */
		reg = <0x11>;
		dsa,member = <0 0>;
		/* 交换机复位脚。原厂 DTB 把这个 GPIO 挂在 mdio@90000 上，但
		 * ipq4019_mdio_probe() 根本不解析 reset-gpios，等于从来没复位过。
		 * qca8k 驱动会在 probe 时拉低再释放，所以挪到交换机节点上才生效。 */
		reset-gpios = <&tlmm 26 GPIO_ACTIVE_LOW>;
		#address-cells = <1>;
		#size-cells = <0>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			/* LAN 口不写 phy-handle：qca8k 会自建 slave_mii_bus，
			 * 用端口号当 PHY 地址自动连接内部 PHY（同
			 * qcom-ipq8064-rb3011.dts 的写法）。 */
			port@1 {
				reg = <1>;
				label = "lan1";
			};

			port@2 {
				reg = <2>;
				label = "lan2";
			};

			port@3 {
				reg = <3>;
				label = "lan3";
			};

			port@6 {
				reg = <6>;
				label = "cpu";
				ethernet = <&dp2>;
				phy-mode = "sgmii";
				qca,sgmii-enable-pll;

				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};
		};
	};
};

&sleep_clk {
	clock-frequency = <32000>;
};

&xo_board_clk {
	clock-div = <4>;
	clock-mult = <1>;
};

&blsp1_uart1 {
	pinctrl-0 = <&serial_0_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&crypto {
	status = "okay";
};

&cryptobam {
	status = "okay";
};

&prng {
	status = "okay";
};

&qfprom {
	status = "okay";
};

&qpic_bam {
	status = "okay";
};

&qpic_nand {
	pinctrl-0 = <&qpic_pins>;
	pinctrl-names = "default";
	status = "okay";

	nand@0 {
		compatible = "spi-nand";
		reg = <0>;
		nand-ecc-engine = <&qpic_nand>;
		nand-bus-width = <8>;

		partitions {
			compatible = "qcom,smem-part";

			partition-0-art {
				label = "0:art";
				read-only;
			};
		};
	};
};

&tlmm {
	mdio1_pins: mdio-state {
		mdc-pins {
			pins = "gpio36";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};

		mdio-pins {
			pins = "gpio37";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	led_pins: led-pins {
		pins = "gpio19";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
	};

	button_pins: button-pins {
		pins = "gpio34", "gpio38";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	qpic_pins: qpic-state {
		clock-pins {
			pins = "gpio9";
			function = "qspi_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cs-pins {
			pins = "gpio8";
			function = "qspi_cs";
			drive-strength = <8>;
			bias-disable;
		};

		data-pins {
			pins = "gpio4", "gpio5", "gpio6", "gpio7";
			function = "qspi_data";
			drive-strength = <8>;
			bias-disable;
		};
	};

	serial_0_pins: uart0-state {
		pins = "gpio28", "gpio29";
		function = "blsp0_uart1";
		drive-strength = <8>;
		bias-disable;
	};
};

&q6_region {
	reg = <0x0 0x4b000000 0x0 0x4500000>;
};

&wifi {
	status = "okay";
	qcom,rproc = <&q6_wcss_pd1>;
	qcom,userpd-subsys-name = "q6v5_wcss_userpd1";
	qcom,ath11k-calibration-variant = "H3C-RT3000-IPQ5018";
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,bdf-addr = <0x4c400000>;
};

&wifi1 {
	status = "okay";
	/* 原厂 DTB（AP-MP02.1, NAND 0xc6478c）里 5G 挂在 userpd2 上：
	 *   q6v5_wcss_userpd2 -> variant H3C-RT3000-QCN6122-0, bdf-addr 0x4d100000
	 *   第三个 qcn6122 节点是 disabled，所以这里是 pd2 不是 pd3。 */
	qcom,rproc = <&q6_wcss_pd2>;
	qcom,userpd-subsys-name = "q6v5_wcss_userpd2";
	qcom,ath11k-calibration-variant = "H3C-RT3000-QCN6122-0";
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,bdf-addr = <0x4d100000>;
	qcom,m3-dump-addr = <0x4df00000>;
};

&wifi2 {
	qcom,ath11k-calibration-variant = "H3C-RT3000-QCN6122-1";
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,bdf-addr = <0x4e500000>;
	qcom,m3-dump-addr = <0x4f200000>;
};
